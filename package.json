{
  "name": "artifact-sdd-extractor-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP para reconstruir especificaciones completas de artifacts de Claude y generar SDDs auditables con trazabilidad total y cero alucinaciones",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "artifact-sdd-extractor-mcp": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "install:claude": "node scripts/install-claude.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sdd",
    "software-design-document",
    "claude-artifact",
    "reverse-engineering",
    "evidence-based"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "express": "^4.21.2",
    "mysql2": "^3.24.5",
    "node-html-parser": "^7.0.1",
    "postcss": "^8.5.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
